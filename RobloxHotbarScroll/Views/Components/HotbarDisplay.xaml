<UserControl x:Class="RobloxHotbarScroll.Views.Components.HotbarDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="105" d:DesignWidth="560">

    <StackPanel HorizontalAlignment="Center">
        <!-- Hotbar Slots Row -->
        <Border Background="{StaticResource BrushBgDark}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8,8"
                HorizontalAlignment="Center">
            <Grid x:Name="HotbarGrid">
                <!-- Floating Animated Highlight Border -->
                <Border x:Name="HighlightIndicator"
                        Width="46" Height="48"
                        CornerRadius="10"
                        Background="{StaticResource BrushAccentCyanGlow}"
                        BorderBrush="{StaticResource BrushAccentCyan}"
                        BorderThickness="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#00E5FF" BlurRadius="14" Opacity="0.6" ShadowDepth="0" />
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="IndicatorTransform" X="0" Y="0" />
                    </Border.RenderTransform>
                </Border>

                <!-- 10 Slots Display [1] [2] [3] [4] [5] [6] [7] [8] [9] [0] -->
                <ItemsControl x:Name="SlotsItemsControl" ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding SelectCommand}"
                                    Width="46" Height="48"
                                    Margin="3,0"
                                    Cursor="Hand"
                                    ToolTip="{Binding TooltipText}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="slotBorder"
                                                Background="{StaticResource BrushBgElevated}"
                                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding KeyLabel}"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource BrushTextPrimary}"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="KEY"
                                                               FontSize="8"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource BrushTextMuted}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,-1,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="slotBorder" Property="Background" Value="{StaticResource BrushBgCardHover}" />
                                                <Setter TargetName="slotBorder" Property="BorderBrush" Value="{StaticResource BrushBorderHighlight}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="slotBorder" Property="Background" Value="Transparent" />
                                                <Setter TargetName="slotBorder" Property="BorderBrush" Value="Transparent" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Dynamic Indicator Below: ▲ CURRENT TRACKED SLOT -->
        <Canvas Height="24" Width="540" Margin="0,4,0,0" HorizontalAlignment="Center">
            <StackPanel x:Name="PointerStack"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        Canvas.Left="0"
                        Canvas.Top="0"
                        Width="46">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="PointerTransform" X="0" />
                </StackPanel.RenderTransform>
                <TextBlock Text="▲"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrushAccentCyan}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="CURRENT"
                           FontSize="8"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrushAccentCyan}"
                           HorizontalAlignment="Center"
                           Margin="0,-2,0,0" />
            </StackPanel>
        </Canvas>
    </StackPanel>
</UserControl>

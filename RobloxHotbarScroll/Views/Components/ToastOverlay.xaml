<UserControl x:Class="RobloxHotbarScroll.Views.Components.ToastOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="360"
             IsHitTestVisible="True">

    <ItemsControl ItemsSource="{Binding ActiveToasts}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,16,16" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="ToastCard"
                        Width="320"
                        Margin="0,6,0,0"
                        Background="#1E1738"
                        BorderBrush="{Binding AccentColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        Opacity="0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.5" ShadowDepth="4" />
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToastTransform" Y="10" />
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Toast Icon Badge -->
                        <Border Grid.Column="0"
                                Width="26" Height="26"
                                CornerRadius="6"
                                Background="{Binding IconBgColor}"
                                BorderBrush="{Binding AccentColor}"
                                BorderThickness="1"
                                Margin="0,0,10,0"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding Icon}"
                                       Foreground="{Binding AccentColor}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!-- Toast Text -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="{Binding Message}"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Dismiss Button -->
                        <Button Grid.Column="2"
                                Content="✕"
                                Click="Dismiss_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource BrushTextMuted}"
                                Cursor="Hand"
                                FontSize="10"
                                VerticalAlignment="Top"
                                Padding="4" />
                    </Grid>

                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ToastCard"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.20">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="ToastTransform"
                                                     Storyboard.TargetProperty="Y"
                                                     From="10" To="0" Duration="0:0:0.20">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Purple / Violet Theme Backgrounds -->
    <Color x:Key="ColorBgDeep">#0A0812</Color>
    <Color x:Key="ColorBgDark">#120E22</Color>
    <Color x:Key="ColorBgCard">#18132E</Color>
    <Color x:Key="ColorBgCardHover">#231B42</Color>
    <Color x:Key="ColorBgElevated">#2D2354</Color>

    <!-- Borders -->
    <Color x:Key="ColorBorderSubtle">#2C224E</Color>
    <Color x:Key="ColorBorderHighlight">#4C3982</Color>
    <Color x:Key="ColorBorderGlow">#8B5CF6</Color>

    <!-- Text & Foreground -->
    <Color x:Key="ColorTextPrimary">#FDFDFE</Color>
    <Color x:Key="ColorTextSecondary">#C4B5FD</Color>
    <Color x:Key="ColorTextMuted">#7E72A2</Color>

    <!-- Premium Purple Accents -->
    <Color x:Key="ColorAccentPurple">#8B5CF6</Color>
    <Color x:Key="ColorAccentPurpleLight">#A78BFA</Color>
    <Color x:Key="ColorAccentPurpleGlow">#3D8B5CF6</Color>

    <!-- State Accents -->
    <Color x:Key="ColorAccentGreen">#10B981</Color>
    <Color x:Key="ColorAccentGreenGlow">#3310B981</Color>
    <Color x:Key="ColorAccentAmber">#F59E0B</Color>
    <Color x:Key="ColorAccentAmberGlow">#33F59E0B</Color>
    <Color x:Key="ColorAccentRed">#EF4444</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="BrushBgDeep" Color="{StaticResource ColorBgDeep}" />
    <SolidColorBrush x:Key="BrushBgDark" Color="{StaticResource ColorBgDark}" />
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}" />
    <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource ColorBgCardHover}" />
    <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource ColorBgElevated}" />

    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushBorderHighlight" Color="{StaticResource ColorBorderHighlight}" />
    <SolidColorBrush x:Key="BrushBorderGlow" Color="{StaticResource ColorBorderGlow}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

    <SolidColorBrush x:Key="BrushAccentPurple" Color="{StaticResource ColorAccentPurple}" />
    <SolidColorBrush x:Key="BrushAccentPurpleLight" Color="{StaticResource ColorAccentPurpleLight}" />
    <SolidColorBrush x:Key="BrushAccentPurpleGlow" Color="{StaticResource ColorAccentPurpleGlow}" />

    <!-- Cyan aliases for compatibility -->
    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentPurple}" />
    <SolidColorBrush x:Key="BrushAccentCyanGlow" Color="{StaticResource ColorAccentPurpleGlow}" />

    <SolidColorBrush x:Key="BrushAccentGreen" Color="{StaticResource ColorAccentGreen}" />
    <SolidColorBrush x:Key="BrushAccentGreenGlow" Color="{StaticResource ColorAccentGreenGlow}" />
    <SolidColorBrush x:Key="BrushAccentAmber" Color="{StaticResource ColorAccentAmber}" />
    <SolidColorBrush x:Key="BrushAccentRed" Color="{StaticResource ColorAccentRed}" />

</ResourceDictionary>
